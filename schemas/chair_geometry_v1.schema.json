{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chair_geometry_v1.schema.json",
  "title": "Chair Geometry Output",
  "type": "object",
  "required": [
    "image_width",
    "image_height",
    "seat_region",
    "floor_line",
    "backrest_region"
  ],
  "properties": {
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "seat_region": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "floor_line": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "backrest_region": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
