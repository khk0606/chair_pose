{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chair_parts_v1.schema.json",
  "title": "Chair Part Segmentation Output",
  "type": "object",
  "required": [
    "image_width",
    "image_height",
    "seat_region",
    "floor_line",
    "backrest_region",
    "parts"
  ],
  "properties": {
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "seat_region": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "floor_line": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "backrest_region": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "parts": {
      "type": "object",
      "required": [
        "seat_confidence",
        "backrest_confidence",
        "floor_confidence",
        "seat_visible",
        "backrest_visible",
        "floor_visible",
        "armrests",
        "legs"
      ],
      "properties": {
        "seat_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "backrest_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "floor_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seat_visible": {
          "type": "boolean"
        },
        "backrest_visible": {
          "type": "boolean"
        },
        "floor_visible": {
          "type": "boolean"
        },
        "armrests": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/line_item"
          }
        },
        "legs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/line_item"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "line_item": {
      "type": "object",
      "required": ["line", "confidence", "visible"],
      "properties": {
        "line": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
