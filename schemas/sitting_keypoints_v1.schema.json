{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sitting_keypoints_v1.schema.json",
  "title": "Sitting Keypoints Output",
  "type": "object",
  "required": ["image_width", "image_height", "keypoints"],
  "properties": {
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "keypoints": {
      "type": "object",
      "required": [
        "hip_center",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist"
      ],
      "properties": {
        "hip_center": {
          "$ref": "#/$defs/keypoint"
        },
        "left_knee": {
          "$ref": "#/$defs/keypoint"
        },
        "right_knee": {
          "$ref": "#/$defs/keypoint"
        },
        "left_ankle": {
          "$ref": "#/$defs/keypoint"
        },
        "right_ankle": {
          "$ref": "#/$defs/keypoint"
        },
        "left_shoulder": {
          "$ref": "#/$defs/keypoint"
        },
        "right_shoulder": {
          "$ref": "#/$defs/keypoint"
        },
        "left_elbow": {
          "$ref": "#/$defs/keypoint"
        },
        "right_elbow": {
          "$ref": "#/$defs/keypoint"
        },
        "left_wrist": {
          "$ref": "#/$defs/keypoint"
        },
        "right_wrist": {
          "$ref": "#/$defs/keypoint"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "keypoint": {
      "type": "object",
      "required": ["x", "y", "confidence", "visible"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
